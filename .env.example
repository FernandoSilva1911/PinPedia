# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env NAO deve ser commitado nem compartilhado.

# String de conexao do Supabase.
# IMPORTANTE: usar a opcao "Transaction pooler" (porta 6543), NAO a conexao
# direta (5432). Em ambiente serverless como a Vercel, a conexao direta esgota
# o limite de conexoes do banco.
# Onde achar: painel do Supabase > Connect > Transaction pooler
DATABASE_URL=postgresql://postgres.SEUPROJETO:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo usado para assinar os tokens JWT. Use um texto longo e aleatorio.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta local do servidor (em producao o Render define isso sozinho)
PORT=3000
