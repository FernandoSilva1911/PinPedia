# Copie para ".env" e preencha. O .env não deve ser commitado.

# Supabase: Connect > Transaction pooler (porta 6543, não a 5432)
DATABASE_URL=postgresql://postgres.SEUPROJETO:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Texto longo e aleatório para assinar os tokens JWT
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta local (na Vercel não é usada)
PORT=3000
